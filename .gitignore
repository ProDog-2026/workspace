# Secrets and credentials (never commit)
.env
.env.*
!.env.example
**/credentials.json
**/client_secret*.json
**/token*.json
**/*.pem
**/*.key

# Local runtimes and generated state
.venv/
.venv-*/
**/.venv/
**/.venv-*/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/*.pid
**/*.log
**/dist/
**/build/

**/*.egg-info/

# Local model weights; the two production detector artifacts are versioned.
**/models/
!src/detector/models/
src/detector/models/*
!src/detector/models/prompt_injection.joblib
!src/detector/models/quadrat-transformer/
!src/detector/models/quadrat-transformer/**

# Regenerable external detector datasets
src/detector/data/vendor/
src/detector/data/processed/

# OS and editor
.DS_Store
Thumbs.db
.vscode/
.idea/
