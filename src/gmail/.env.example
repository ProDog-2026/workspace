# Local-only prototype. Run scripts/setup_local.py to generate a secret encryption key.
APP_MODE=demo
APP_BASE_URL=http://127.0.0.1:8765
# Set to the dashboard dev server to return there after Google OAuth. Empty = this module's page.
DASHBOARD_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=data/prodog.db

# Dynamic analysis: local loopback only. Keys stay in the backend, never in VITE_*.
EXPERIMENTS_ENABLED=true
# Select a locally installed model that supports tool calling; no automatic download.
OLLAMA_MODEL=
# Static ML + Transformer use separate Python 3.12; defaults point to src/detector.
# In src/detector: uv sync --python 3.12 --extra transformer --dev
# Override only if your trusted team artifact/interpreter is elsewhere:
# STATIC_PYTHON=../detector/.venv/bin/python
# STATIC_MODEL_PATH=../detector/models/prompt_injection.joblib
# Windows STATIC_PYTHON=../detector/.venv/Scripts/python.exe
# Only the provider you select needs a key. Free plan/quota must be checked in your account.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Use the dedicated VM after following docs/local-vm.md. Empty preserves the existing Docker context.
SANDBOX_DOCKER_CONTEXT=

# 탐지 모델 파일(src/detector, Git에 없음). 비우면 판정 없이 검사 전으로 표시
DETECTOR_MODEL_PATH=

# Supabase Auth 검증·서버 쓰기. URL과 anon 키는 동일 프로젝트를 사용한다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# sb_secret_ 또는 legacy service_role 키. 서버 .env에만 두고 VITE_ 변수에 넣지 않는다.
SUPABASE_SERVICE_KEY=
